{
  "name": "brightloop-server",
  "version": "1.0.0",
  "private": true,
  "description": "Brightloop Software subscription management API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:create": "tsx src/db/create-database.ts",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "npm run db:init && tsx src/db/seed.ts",
    "db:seed:perf": "npm run db:init && tsx src/db/seed_performance.ts",
    "db:setup": "npm run db:create && npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
