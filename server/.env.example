# ---------------------------------------------------------------------------
# Brightloop API — local environment template
# Copy this file to `.env` and fill in DATABASE_URL. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Local PostgreSQL 18 connection string.
# Format: postgresql://USER:PASSWORD@localhost:5432/brightloop_db
# The password contains no special URL characters in the common case; if it
# does, percent-encode them (for example @ -> %40).
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/brightloop_db

# Signing key for JWTs. Minimum 32 characters in production.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Token lifetime, e.g. 7d, 12h, 60m.
JWT_EXPIRES_IN=7d

# bcrypt work factor.
BCRYPT_ROUNDS=10

# API port and the Vite dev server origin allowed through CORS.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
